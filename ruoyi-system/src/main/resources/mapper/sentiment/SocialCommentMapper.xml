<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.sentiment.SocialCommentMapper">
    <resultMap type="com.ruoyi.system.domain.sentiment.SocialComment" id="R">
        <result property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="title" column="title"/>
        <result property="commentId" column="comment_id"/>
        <result property="commenter" column="commenter"/>
        <result property="commentContent" column="comment_content"/>
        <result property="likeCount" column="like_count"/>
        <result property="commentTime" column="comment_time"/>
    </resultMap>
    <sql id="cols">select id,post_id,title,comment_id,commenter,comment_content,like_count,comment_time from social_comment</sql>
    <select id="selectByPostId" parameterType="String" resultMap="R">
        <include refid="cols"/> where post_id=#{postId} order by comment_time
    </select>
    <select id="selectList" parameterType="com.ruoyi.system.domain.sentiment.SocialComment" resultMap="R">
        <include refid="cols"/><where>
            <if test="postId!=null and postId!=''">AND post_id=#{postId}</if>
            <if test="commenter!=null and commenter!=''">AND commenter like concat('%',#{commenter},'%')</if>
        </where>order by comment_time desc
    </select>
    <delete id="deleteByPostId" parameterType="String">delete from social_comment where post_id=#{postId}</delete>
</mapper>
