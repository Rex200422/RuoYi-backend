<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.sentiment.HighFrequencyUserMapper">

    <resultMap type="com.ruoyi.system.domain.sentiment.HighFrequencyUser" id="Result">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="platform" column="platform"/>
        <result property="postCount" column="post_count"/>
        <result property="windowStart" column="window_start"/>
        <result property="windowEnd" column="window_end"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, platform, post_count, window_start, window_end, created_at
    </sql>

    <insert id="batchInsertOrUpdate" parameterType="java.util.List">
        INSERT INTO high_frequency_user
            (username, platform, post_count, window_start, window_end)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.username}, #{item.platform}, #{item.postCount},
             #{item.windowStart}, #{item.windowEnd})
        </foreach>
        ON DUPLICATE KEY UPDATE
            post_count = VALUES(post_count),
            window_end = VALUES(window_end)
    </insert>

    <select id="selectTopByPlatform" resultMap="Result">
        SELECT <include refid="Base_Column_List"/>
        FROM high_frequency_user
        WHERE window_start >= DATE_SUB(NOW(), INTERVAL 3 DAY)
        ORDER BY platform, post_count DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteByWindowStartBefore">
        DELETE FROM high_frequency_user WHERE window_start &lt; #{time}
    </delete>

</mapper>
